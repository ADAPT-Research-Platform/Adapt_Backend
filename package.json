{
  "name": "AdaptBackend",
  "version": "1.0.0",
  "description": "ADAPT Backend.",
  "main": "index.js",
  "author": "Binayak Adhikari",
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.6.2",
    "typeorm": "^0.3.20",
    "validator": "^13.11.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/validator": "^13.11.9",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.56.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "start": "node build/index.js",
    "dev": "yarn && nodemon -L src/index.ts --watch \"src/**/*.{ts,js}\"",
    "build": "tsc -p tsconfig-build.json",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint --fix \"{src,__tests__}/**/*.{ts,js}\"",
    "lint": "eslint \"{src,__tests__}/**/*.{ts,js}\"",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --collectCoverage",
    "docker:up": "docker-compose up -d && yarn docker:shell",
    "docker:db:up": "docker-compose up db",
    "docker:down": "docker-compose down",
    "docker:shell": "docker exec -it api sh",
    "docker:build": "docker build -t adapt-node-api .",
    "migration:generate": "sh -c 'ts-node ./node_modules/typeorm/cli.js migration:generate -d build/data-source.js build/migrations/$0'",
    "migration:create": "sh -c 'ts-node ./node_modules/typeorm/cli.js migration:create build/migrations/$0'",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d build/data-source.js",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d build/data-source.js"
  }
}
