[ req ]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = req_distinguished_name
x509_extensions = v3_ca

[ req_distinguished_name ]
countryName = DE
stateOrProvinceName = Hessen
localityName = Marburg
organizationalUnitName = University of Marburg
commonName = 127.0.0.1  # Your IP address or domain name

[ v3_ca ]
subjectAltName = @alt_names

[ alt_names ]
IP.1 = 127.0.0.1  # The IP address of your server
IP.2 = 10.0.2.2
